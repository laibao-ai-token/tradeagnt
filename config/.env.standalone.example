# tradeagnt 独立版精简配置（复制为 config/.env 后 chmod 600）
# 完整模板见 config/.env.example

# --- 运行剖面（TUI 双市场演示）---
TRADECAT_PIPELINE_PROFILE=tui_dual
# TRADEAGNT_PIPELINE_PROFILE=tui_dual

# --- 代理（国内访问 Binance / 美股源时常用）---
HTTP_PROXY=
HTTPS_PROXY=

# --- 数据路径（可选；默认 data/ 优先，见 docs/MIGRATE_v0.8_to_v1.0.md）---
# TRADEAGNT_DATA_DIR=
# SIGNAL_DB_PATH=
# PAPER_DB_PATH=

# --- TUI ---
TUI_AUTO_START_COLLECTOR=0
TUI_AUTO_START_SIGNAL=0
PAPER_AUTO_MARKET=all

# --- 模拟盘（可按需调整）---
# PAPER_INITIAL_CASH=10000
# PAPER_NOTIONAL_PCT=0.2

# --- 可选：TimescaleDB（独立版默认可不启）---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5434/market_data

# --- 可选：Linear MCP ---
# LINEAR_API_KEY=
# LINEAR_TEAM_KEY=

# --- legacy 129 规则桥（默认关闭）---
# TRADEAGNT_LEGACY_RULES=0
